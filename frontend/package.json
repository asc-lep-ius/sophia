{
  "name": "@sophia/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "svelte-kit sync",
    "openapi:types": "openapi-typescript ./src/lib/api/openapi.json -o ./src/lib/api/schema.d.ts && node ./scripts/normalize-openapi-types.mjs && pnpm run guard:openapi-types",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "paraglide:check": "pnpm run paraglide:compile && node ./scripts/assert-message-keys.mjs",
    "check": "pnpm run guard:package-contract && pnpm run paraglide:compile && pnpm run openapi:types && pnpm run guard:api-client && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "guard:api-client": "node ./scripts/assert-api-client-contract.mjs",
    "guard:package-contract": "node ./scripts/assert-package-contract.mjs",
    "guard:openapi-types": "node ./scripts/assert-openapi-types.mjs",
    "guard:server-fetch": "node ./scripts/assert-server-load-fetch.mjs",
    "lint": "pnpm run paraglide:compile && pnpm run guard:server-fetch && pnpm run guard:openapi-types && pnpm run guard:api-client && eslint . && prettier --check .",
    "test:unit": "pnpm run paraglide:compile && vitest run --config ./vitest.config.ts",
    "test:e2e": "pnpm run paraglide:compile && playwright test --config ./playwright.config.ts",
    "size-limit": "pnpm run build && size-limit"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.18.1",
    "@tailwindcss/vite": "4.3.0",
    "mode-watcher": "1.1.0",
    "openapi-fetch": "0.17.0",
    "svelte": "5.55.9",
    "tailwindcss": "4.3.0",
    "web-vitals": "5.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "@size-limit/preset-small-lib": "12.1.0",
    "@sveltejs/adapter-node": "5.5.4",
    "@sveltejs/kit": "2.61.0",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.3.1",
    "@types/node": "25.9.1",
    "eslint": "10.4.0",
    "eslint-plugin-svelte": "3.17.1",
    "globals": "17.6.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.0.1",
    "shadcn-svelte": "1.2.7",
    "size-limit": "12.1.0",
    "svelte-check": "4.4.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.4",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "size-limit": [
    {
      "path": ".svelte-kit/output/client/_app/immutable/**/*.js",
      "limit": "260 KB"
    }
  ]
}
