# Transitional CPU-only image for the legacy NiceGUI surface.
FROM python:3.12-slim AS base
ENV TERM=xterm-256color LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN pip install uv

FROM base AS builder
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY src/ src/
RUN uv sync --extra web --no-dev --frozen

FROM base AS runtime
WORKDIR /app
ENV SOPHIA_DATA_DIR=/data
ENV HF_HOME=/home/sophia/.cache/huggingface
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app /app
RUN useradd --create-home --uid 1000 sophia
RUN mkdir -p /data /app/.nicegui /home/sophia/.cache/huggingface \
    && chown sophia:sophia /data /app/.nicegui /home/sophia/.cache/huggingface
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --retries=3 --start-period=10s \
    CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"]
USER sophia
CMD ["/app/.venv/bin/python", "-m", "sophia", "gui", "--host", "0.0.0.0"]