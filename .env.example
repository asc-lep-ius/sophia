# Auth: run `sophia auth login` to authenticate via browser (SSO)

# SECRET — never commit actual values
SOPHIA_GEMINI_API_KEY=          # optional: enables LLM topic extraction
# SECRET — never commit actual values
SOPHIA_GROQ_API_KEY=            # optional: LLM fallback provider
# SECRET — never commit actual values
SOPHIA_ANNAS_API_KEY=           # optional: Anna's Archive JSON API

# Configuration (not secrets — safe to commit)
# SOPHIA_DOWNLOAD_DIR=~/Downloads/sophia
# SOPHIA_MAX_DOWNLOAD_SIZE_BYTES=5368709120
# SOPHIA_GUI_PORT=8080
# GPU: use compose profile instead → make docker-gui-up-gpu
# GITHUB_TOKEN=                  # optional: higher GitHub API rate limits

# Postgres — the only datastore the application reads or writes.
# Compose builds SOPHIA_DATABASE_URL for the containers from the three
# SOPHIA_POSTGRES_* values below; set it directly only when running outside
# Compose, and keep the +asyncpg driver (the sync driver is rejected at startup).
SOPHIA_POSTGRES_USER=sophia
# SECRET — never commit actual values
# Must be URL-safe: Compose interpolates this straight into the DSN, so @ : / #
# and ? have to be percent-encoded or the URL parses as a different host.
SOPHIA_POSTGRES_PASSWORD=
SOPHIA_POSTGRES_DB=sophia
# SOPHIA_DATABASE_URL=postgresql+asyncpg://sophia:sophia@localhost:5432/sophia
