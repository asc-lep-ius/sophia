{
	order rate_limit before reverse_proxy
	admin off

	servers {
		protocols h1 h2 h3
	}
}

(forwarded_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
}

{$SOPHIA_SITE_ADDRESS:http://localhost} {
	log {
		output stdout
		format json
	}

	rate_limit {
		zone login_per_ip {
			match {
				method POST
				path /api/auth/login /api/auth/login/
			}
			key {remote_host}
			events 5
			window 1m
			ipv6_prefix 64
		}
		jitter 10
	}

	@api_uploads path /api/uploads/* /api/imports/* /api/content-sources/*/upload* /api/files/*
	request_body @api_uploads {
		max_size 512MB
	}

	@legacy_uploads path /_nicegui/upload* /legacy/_nicegui/upload*
	request_body @legacy_uploads {
		max_size 512MB
	}

	@api_sse path /api/events* /api/*/events* /api/*/stream*
	# SSE paths must be handled before generic /api/* so Caddy streams events
	# immediately and avoids upstream response compression for event streams.
	handle @api_sse {
		reverse_proxy api:8000 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /api
			flush_interval -1
			stream_close_delay 5m
			transport http {
				compression off
			}
		}
	}

	redir /app /app/ 308
	handle /app/* {
		reverse_proxy frontend:3000 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /app
		}
	}

	handle /api/* {
		reverse_proxy api:8000 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /api
		}
	}

	redir /legacy /legacy/ 308
	handle_path /legacy/* {
		reverse_proxy sophia-gui:8080 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /legacy
		}
	}

	handle {
		reverse_proxy sophia-gui:8080 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /
		}
	}
}
