{
	order rate_limit before reverse_proxy
	admin off

	servers {
		protocols h1 h2 h3
	}
}

(forwarded_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Host {host}
	header_up X-Forwarded-Proto {scheme}
}

{$SOPHIA_SITE_ADDRESS:http://localhost} {
	log {
		output stdout
		format json
	}

	rate_limit {
		zone login_per_ip {
			match {
				method POST
				path /api/auth/login /api/auth/login/
			}
			key {remote_host}
			events 5
			window 1m
			ipv6_prefix 64
		}
		jitter 10
	}

	@api_uploads path /api/uploads/* /api/imports/* /api/content-sources/uploads /api/content-sources/*/upload* /api/files/*
	request_body @api_uploads {
		max_size 512MB
	}

	# /api/study/*/events matches the study realtime SSE endpoint explicitly:
	# it has two path segments between /api/ and /events (study, {session_id}),
	# which /api/*/events* alone does not reliably cover.
	@api_sse path /api/events* /api/*/events* /api/*/stream* /api/study/*/events*
	# SSE paths must be handled before generic /api/* so Caddy streams events
	# immediately and avoids upstream response compression for event streams.
	handle @api_sse {
		reverse_proxy api:8000 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /api
			flush_interval -1
			stream_close_delay 5m
			transport http {
				compression off
			}
		}
	}

	# The app lives under /app/, so the site root is a redirect rather than an
	# upstream. It was the NiceGUI fallback until issue #102 retired it, and
	# leaving it unhandled would answer a bookmark of the bare origin with a
	# 404. Rebasing the frontend onto / is a URL change this issue does not ask
	# for; every link, every cookie path and every e2e spec assumes /app.
	redir / /app/ 308
	redir /app /app/ 308
	handle /app/* {
		reverse_proxy frontend:3000 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /app
		}
	}

	handle /api/* {
		reverse_proxy api:8000 {
			import forwarded_headers
			header_up X-Forwarded-Prefix /api
		}
	}

	# Anything else — /legacy/* above all — is not served. A hidden path kept
	# "just in case" is the anti-pattern this issue was written against: it is
	# unaudited behaviour that nothing tests and nobody watches.
	handle {
		respond 404
	}
}
